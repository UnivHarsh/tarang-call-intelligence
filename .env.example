# ---------------------------------------------------------------------------
# Tarang — environment
# Copy to .env.local for local dev. Add the same vars in Vercel > Settings > Env.
# Every one of these is OPTIONAL: with none set, the app runs in Demo Mode and
# the full pipeline still works end to end on the seeded corpus.
# ---------------------------------------------------------------------------

# --- Voice layer (VAPI) ---------------------------------------------------
# Public key is safe in the browser bundle — it is what the Web SDK expects.
NEXT_PUBLIC_VAPI_PUBLIC_KEY=
# The assistant you created from vapi/assistant.json
NEXT_PUBLIC_VAPI_ASSISTANT_ID=
# Private key: server-side only (used to pull recordings / call records).
VAPI_PRIVATE_KEY=
# Shared secret you set on the VAPI server-URL webhook, to reject spoofed posts.
VAPI_WEBHOOK_SECRET=

# --- Insight extraction (LLM) ---------------------------------------------
ANTHROPIC_API_KEY=
# Optional override. Defaults to a fast, cheap model.
TARANG_MODEL=claude-haiku-4-5-20251001

# ---------------------------------------------------------------------------
# Tarang — environment
# Copy to .env.local for local dev. Add the same vars in Vercel > Settings > Env.
# Every one of these is OPTIONAL: with none set, the app runs in Demo Mode and
# the full pipeline still works end to end on the seeded corpus.
# ---------------------------------------------------------------------------

# --- Insight extraction (Gemini) ------------------------------------------
# Free key from https://aistudio.google.com/apikey — no billing account, no
# credit card. Server-side only; this never reaches the browser.
GEMINI_API_KEY=

# Optional model override. Defaults to gemini-3.7-flash.
# Verified working: gemini-3.7-flash | gemini-3.6-flash | gemini-3.5-flash-lite
# (the 2.5 models are retired for new keys). All are on the free tier.
TARANG_MODEL=

# --- Voice layer (Vapi) ----------------------------------------------------
# Public key is safe in the browser bundle — it is what the Web SDK expects.
NEXT_PUBLIC_VAPI_PUBLIC_KEY=
# Optional: only if you created an assistant in the Vapi dashboard instead of
# using the inline config in src/lib/vapi-assistant.ts
NEXT_PUBLIC_VAPI_ASSISTANT_ID=

# --- Cosmetic --------------------------------------------------------------
# Shows a "Source" link in the header when set.
NEXT_PUBLIC_REPO_URL=
